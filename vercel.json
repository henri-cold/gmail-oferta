{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "videos/**", "use": "@vercel/static" },
    { "src": "logozuda.webp", "use": "@vercel/static" },
    { "src": "favicon.svg", "use": "@vercel/static" },
    { "src": "instagram.png", "use": "@vercel/static" },
    { "src": "piximage.jpg", "use": "@vercel/static" },
    { "src": "banner.webp", "use": "@vercel/static" },
    { "src": "atendente.png", "use": "@vercel/static" },
    { "src": "atendente_voz.mp3", "use": "@vercel/static" },
    { "src": "atendente_voz2.mp3", "use": "@vercel/static" },
    { "src": "atendente_voz3.mp3", "use": "@vercel/static" },
    { "src": "atendente_voz4.mp3", "use": "@vercel/static" },
    { "src": "atendente_voz5.mp3", "use": "@vercel/static" },
    { "src": "atendente_voz6.mp3", "use": "@vercel/static" },
    { "src": "atendente_voz7.mp3", "use": "@vercel/static" },
    { "src": "public/itau-logo.png", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/videos/(.*)", "dest": "/videos/$1" },
    { "src": "/logozuda.webp", "dest": "/logozuda.webp" },
    { "src": "/favicon.svg", "dest": "/favicon.svg" },
    { "src": "/instagram.png", "dest": "/instagram.png" },
    { "src": "/piximage.jpg", "dest": "/piximage.jpg" },
    { "src": "/banner.webp", "dest": "/banner.webp" },
    { "src": "/atendente.png", "dest": "/atendente.png" },
    { "src": "/atendente_voz.mp3", "dest": "/atendente_voz.mp3" },
    { "src": "/atendente_voz2.mp3", "dest": "/atendente_voz2.mp3" },
    { "src": "/atendente_voz3.mp3", "dest": "/atendente_voz3.mp3" },
    { "src": "/atendente_voz4.mp3", "dest": "/atendente_voz4.mp3" },
    { "src": "/atendente_voz5.mp3", "dest": "/atendente_voz5.mp3" },
    { "src": "/atendente_voz6.mp3", "dest": "/atendente_voz6.mp3" },
    { "src": "/atendente_voz7.mp3", "dest": "/atendente_voz7.mp3" },
    { "src": "/itau", "dest": "/server.js" },
    { "src": "/itau-logo.png", "dest": "/public/itau-logo.png" },
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}
