{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "videos/**", "use": "@vercel/static" },
    { "src": "logozuda.webp", "use": "@vercel/static" },
    { "src": "favicon.svg", "use": "@vercel/static" },
    { "src": "instagram.png", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/videos/(.*)", "dest": "/videos/$1" },
    { "src": "/logozuda.webp", "dest": "/logozuda.webp" },
    { "src": "/favicon.svg", "dest": "/favicon.svg" },
    { "src": "/instagram.png", "dest": "/instagram.png" },
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}
