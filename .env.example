# Credenciais da SafiPay — crie as suas em https://www.safipaybr.com/api-keys
# NUNCA versione o arquivo .env real. Mantenha-o fora do git (já está no .gitignore).
SAFIPAY_CLIENT_ID=ck_xxxxxxxxxxxxxxxxxxxxxxxx
SAFIPAY_CLIENT_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Segredo do webhook (painel da SafiPay > Webhooks ou na própria API Key).
# Comece com whsec_ (segredo da chave) ou os 64 hex da conta. Deixe vazio para pular validação em teste local.
SAFIPAY_WEBHOOK_SECRET=

# Porta do servidor
PORT=3000

# Preço do produto em reais (ponto decimal, até 2 casas)
PRODUCT_PRICE=47.00
